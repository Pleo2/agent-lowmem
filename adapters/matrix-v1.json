{
  "$schema": "https://agentlowmem.dev/schema/adapter-matrix-v1.json",
  "version": 1,
  "_evidence": {
    "npm-scripts": "https://docs.npmjs.com/cli/using-npm/scripts/",
    "npm-workspaces": "https://docs.npmjs.com/cli/using-npm/workspaces/",
    "pnpm-run": "https://pnpm.io/cli/run",
    "pnpm-settings": "https://pnpm.io/settings",
    "vitest": "https://v4.vitest.dev/guide/cli",
    "jest": "https://jestjs.io/docs/cli",
    "node-test": "https://nodejs.org/api/test.html",
    "typescript": "https://www.typescriptlang.org/docs/handbook/compiler-options.html",
    "eslint": "https://eslint.org/docs/latest/use/command-line-interface",
    "next": "https://nextjs.org/docs/app/api-reference/cli/next",
    "nest": "https://docs.nestjs.com/cli/usages"
  },
  "packageManagers": [
    {
      "name": "npm",
      "version": "12.0.2",
      "rootArguments": ["--script-shell=/bin/sh", "run", "{script}"],
      "workspaceArguments": ["--script-shell=/bin/sh", "--workspace={packageName}", "run", "{script}"]
    },
    {
      "name": "pnpm",
      "version": "11.25.0",
      "rootArguments": ["--config.script-shell=/bin/sh", "--config.shell-emulator=false", "run", "{script}"],
      "workspaceArguments": ["--config.script-shell=/bin/sh", "--config.shell-emulator=false", "--filter", "{packageName}", "--fail-if-no-match", "run", "{script}"]
    }
  ],
  "adapters": [
    {
      "packageName": "vitest",
      "executable": "vitest",
      "version": "4.1.11",
      "kind": "command",
      "classification": "controlled",
      "requiredPrefix": ["run"],
      "requiredControls": ["--no-file-parallelism", "--maxWorkers=1"],
      "suffix": ["--no-file-parallelism", "--maxWorkers=1"],
      "supportsForwardedArguments": true,
      "denials": [
        {"reason": "watch-denied", "exact": ["--watch", "-w"], "keyValue": ["--watch"]},
        {"reason": "ui-denied", "exact": ["--ui", "--open"], "keyValue": ["--ui"]},
        {"reason": "background-denied", "exact": ["--standalone"], "keyValue": []},
        {"reason": "parallel-denied", "exact": ["--fileParallelism", "--maxWorkers", "--pool=forks", "--shard"], "keyValue": ["--fileParallelism", "--maxWorkers", "--pool", "--shard"]}
      ],
      "disclosure": null
    },
    {
      "packageName": "jest",
      "executable": "jest",
      "version": "30.5.1",
      "kind": "command",
      "classification": "controlled",
      "requiredPrefix": [],
      "requiredControls": ["--runInBand"],
      "suffix": ["--runInBand"],
      "supportsForwardedArguments": true,
      "denials": [
        {"reason": "watch-denied", "exact": ["--watch", "--watchAll"], "keyValue": ["--watch", "--watchAll"]},
        {"reason": "parallel-denied", "exact": ["--maxWorkers", "-w", "--shard"], "keyValue": ["--maxWorkers", "--shard"]}
      ],
      "disclosure": null
    },
    {
      "packageName": "node",
      "executable": "node",
      "version": "24.14.1",
      "kind": "runtime",
      "classification": "controlled",
      "requiredPrefix": ["--test"],
      "requiredControls": ["--test-concurrency=1"],
      "suffix": ["--test-concurrency=1"],
      "supportsForwardedArguments": true,
      "denials": [
        {"reason": "watch-denied", "exact": ["--watch"], "keyValue": ["--watch"]},
        {"reason": "parallel-denied", "exact": ["--test-concurrency"], "keyValue": ["--test-concurrency"]}
      ],
      "disclosure": null
    },
    {
      "packageName": "typescript",
      "executable": "tsc",
      "version": "7.0.2",
      "kind": "command",
      "classification": "controlled",
      "requiredPrefix": [],
      "requiredControls": [],
      "suffix": [],
      "supportsForwardedArguments": true,
      "denials": [
        {"reason": "watch-denied", "exact": ["--watch", "-w"], "keyValue": ["--watch"]}
      ],
      "disclosure": null
    },
    {
      "packageName": "eslint",
      "executable": "eslint",
      "version": "10.9.1",
      "kind": "command",
      "classification": "controlled",
      "requiredPrefix": [],
      "requiredControls": ["--concurrency=off"],
      "suffix": ["--concurrency=off"],
      "supportsForwardedArguments": true,
      "denials": [
        {"reason": "watch-denied", "exact": ["--watch"], "keyValue": ["--watch"]},
        {"reason": "ui-denied", "exact": ["--inspect-config"], "keyValue": []},
        {"reason": "parallel-denied", "exact": ["--concurrency"], "keyValue": ["--concurrency"]}
      ],
      "disclosure": null
    },
    {
      "packageName": "next",
      "executable": "next",
      "version": "16.3.4",
      "kind": "command",
      "classification": "disclosed",
      "requiredPrefix": ["build"],
      "requiredControls": [],
      "suffix": [],
      "supportsForwardedArguments": true,
      "denials": [
        {"reason": "watch-denied", "exact": ["--watch"], "keyValue": ["--watch"]},
        {"reason": "argument-denied", "exact": ["--experimental-build-mode"], "keyValue": ["--experimental-build-mode"]}
      ],
      "disclosure": "internal-fanout-uncontrolled"
    },
    {
      "packageName": "@nestjs/cli",
      "executable": "nest",
      "version": "12.0.0",
      "kind": "command",
      "classification": "disclosed",
      "requiredPrefix": ["build"],
      "requiredControls": [],
      "suffix": [],
      "supportsForwardedArguments": true,
      "denials": [
        {"reason": "watch-denied", "exact": ["--watch"], "keyValue": ["--watch"]}
      ],
      "disclosure": "internal-fanout-uncontrolled"
    },
    {
      "packageName": "cross-env",
      "executable": "cross-env",
      "version": "10.1.0",
      "kind": "wrapper",
      "classification": "auxiliary",
      "requiredPrefix": [],
      "requiredControls": [],
      "suffix": [],
      "supportsForwardedArguments": false,
      "denials": [],
      "disclosure": null
    },
    {
      "packageName": "dotenv-cli",
      "executable": "dotenv",
      "version": "11.0.0",
      "kind": "wrapper",
      "classification": "auxiliary",
      "requiredPrefix": [],
      "requiredControls": [],
      "suffix": [],
      "supportsForwardedArguments": false,
      "denials": [],
      "disclosure": null
    },
    {
      "packageName": "rimraf",
      "executable": "rimraf",
      "version": "6.1.3",
      "kind": "auxiliary",
      "classification": "auxiliary",
      "requiredPrefix": [],
      "requiredControls": [],
      "suffix": [],
      "supportsForwardedArguments": false,
      "denials": [],
      "disclosure": null
    }
  ]
}
