#!/bin/sh
if [ -n "${AGENT_LOWMEM_SENTINEL_MARKER:-}" ]; then
  /usr/bin/touch "$AGENT_LOWMEM_SENTINEL_MARKER"
fi
if [ -n "${AGENT_LOWMEM_RESULT_CONFLICT:-}" ]; then
  /bin/ln -s /tmp/agent-lowmem-unsafe-result "$AGENT_LOWMEM_RESULT_CONFLICT"
fi
/bin/echo "fixture-child-stdout"
/bin/echo "fixture-child-stderr" >&2
if [ -n "${AGENT_LOWMEM_FIXTURE_WAIT:-}" ]; then
  /bin/sleep 30
fi
exit "${AGENT_LOWMEM_FIXTURE_EXIT:-0}"
