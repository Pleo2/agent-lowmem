{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlowmem.dev/schema/adapter-matrix-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "_evidence", "packageManagers", "adapters"],
  "properties": {
    "$schema": {"const": "https://agentlowmem.dev/schema/adapter-matrix-v1.json"},
    "version": {"const": 1},
    "_evidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^https://"}
    },
    "packageManagers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/packageManager"}
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/adapter"}
    }
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "packageManager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "rootArguments", "workspaceArguments"],
      "properties": {
        "name": {"enum": ["npm", "pnpm"]},
        "version": {"type": "string", "minLength": 1},
        "rootArguments": {"$ref": "#/$defs/stringArray"},
        "workspaceArguments": {"$ref": "#/$defs/stringArray"}
      }
    },
    "denial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "exact", "keyValue"],
      "properties": {
        "reason": {"enum": ["watch-denied", "ui-denied", "background-denied", "parallel-denied", "argument-denied"]},
        "exact": {"$ref": "#/$defs/stringArray"},
        "keyValue": {"$ref": "#/$defs/stringArray"}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "executable", "version", "kind", "classification", "requiredPrefix", "requiredControls", "suffix", "supportsForwardedArguments", "denials", "disclosure"],
      "properties": {
        "packageName": {"type": "string", "minLength": 1},
        "executable": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "kind": {"enum": ["command", "runtime", "wrapper", "auxiliary"]},
        "classification": {"enum": ["controlled", "disclosed", "auxiliary"]},
        "requiredPrefix": {"$ref": "#/$defs/stringArray"},
        "requiredControls": {"$ref": "#/$defs/stringArray"},
        "suffix": {"$ref": "#/$defs/stringArray"},
        "supportsForwardedArguments": {"type": "boolean"},
        "denials": {"type": "array", "items": {"$ref": "#/$defs/denial"}},
        "disclosure": {"type": ["string", "null"]}
      }
    }
  }
}
